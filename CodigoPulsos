from pathlib import Path
import matplotlib.pyplot as plt
import numpy as np
import pandas as pd
from scipy.optimize import curve_fit

COL_TEMP = "CPU (Tctl/Tdie) [°C]"
COL_POTENCIA = "Potencia total de CPU [W]"
COL_HTC = "Desaceleración térmica (HTC) [Yes/No]"
COL_TIEMPO = "TiempoSimulacion"


def cargar_columnas_pulsos(ruta_csv: Path) -> tuple[np.ndarray, np.ndarray, np.ndarray, np.ndarray]:
    """Extrae tiempo (s), temperatura, potencia y flag HTC."""
    df = pd.read_csv(ruta_csv, encoding="utf-8-sig")

    temp_serie = pd.to_numeric(df[COL_TEMP], errors="coerce")
    power_serie = pd.to_numeric(df[COL_POTENCIA], errors="coerce")
    htc_serie = (
        df[COL_HTC]
        .astype(str)
        .str.strip()
        .str.lower()
        .eq("yes")
        .astype(int)
    )

    if COL_TIEMPO in df.columns:
        t_serie = pd.to_numeric(df[COL_TIEMPO], errors="coerce")
        validas = temp_serie.notna() & power_serie.notna() & t_serie.notna()
        t_s = t_serie[validas].to_numpy(dtype=float)
    else:
        validas = temp_serie.notna() & power_serie.notna()
        t_s = np.arange(int(np.sum(validas)), dtype=float)

    temp_c = temp_serie[validas].to_numpy(dtype=float)
    power_w = power_serie[validas].to_numpy(dtype=float)
    htc_flag = htc_serie[validas].to_numpy(dtype=int)
    return t_s, temp_c, power_w, htc_flag


def promedio_en_ventana(t_s: np.ndarray, senal: np.ndarray, t_ini: float, t_fin: float) -> float:
    """Promedio de una señal en [t_ini, t_fin]."""
    mascara = (t_s >= t_ini) & (t_s <= t_fin)
    if not np.any(mascara):
        return float("nan")
    return float(np.mean(senal[mascara]))


def r_termica(t_estres: float, t_normal: float, p_estres: float, p_normal: float) -> float:
    """R_th = (T_estres - T_normal) / (P_estres - P_normal)."""
    dp = p_estres - p_normal
    if np.isnan(dp) or np.isclose(dp, 0.0):
        return float("nan")
    return (t_estres - t_normal) / dp


def curva_exponencial(t_rel: np.ndarray, t_eq: float, t_ini: float, tau: float) -> np.ndarray:
    """T(t_rel) = T_eq + (T_ini - T_eq) * exp(-t_rel / tau)."""
    return t_eq + (t_ini - t_eq) * np.exp(-t_rel / tau)


def ajustar_tau(
    t_rel: np.ndarray, temp_tramo: np.ndarray, tau_semilla: float = 10.0
) -> tuple[float, float, float]:
    """Ajusta tau, T_ini y T_eq sobre un tramo."""
    if len(t_rel) < 5:
        return float("nan"), float("nan"), float("nan")
    try:
        popt, _ = curve_fit(
            lambda x, t_eq, t_ini, tau: curva_exponencial(x, t_eq, t_ini, tau),
            t_rel,
            temp_tramo,
            p0=[float(temp_tramo[-1]), float(temp_tramo[0]), tau_semilla],
            bounds=([0.0, 0.0, 0.1], [130.0, 150.0, 3000.0]),
            maxfev=20000,
        )
        return float(popt[2]), float(popt[1]), float(popt[0])
    except Exception:
        return float("nan"), float("nan"), float("nan")


def c_termica(tau: float, r_th: float) -> float:
    """C_th = tau / R_th."""
    if np.isnan(tau) or np.isnan(r_th) or np.isclose(r_th, 0.0):
        return float("nan")
    return tau / r_th


def analizar_todos_los_ciclos(
    t_s: np.ndarray, temp_c: np.ndarray, power_w: np.ndarray, n_ciclos: int = 6
) -> list[dict[str, float | int]]:
    """Calcula R_th, tau y C_th para cada ciclo de (1 min normal + 1 min estrés)."""
    resultados: list[dict[str, float | int]] = []
    for k in range(n_ciclos):
        t_norm_ini, t_norm_fin = 120.0 * k + 55.0, 120.0 * k + 59.0
        t_estr_ini, t_estr_fin = 120.0 * k + 115.0, 120.0 * k + 119.0
        t_enf_ini, t_enf_fin = 120.0 * k + 121.0, 120.0 * k + 179.0

        t_norm = promedio_en_ventana(t_s, temp_c, t_norm_ini, t_norm_fin)
        p_norm = promedio_en_ventana(t_s, power_w, t_norm_ini, t_norm_fin)
        t_estr = promedio_en_ventana(t_s, temp_c, t_estr_ini, t_estr_fin)
        p_estr = promedio_en_ventana(t_s, power_w, t_estr_ini, t_estr_fin)

        r_th = r_termica(t_estr, t_norm, p_estr, p_norm)

        m_enf = (t_s >= t_enf_ini) & (t_s <= t_enf_fin)
        tau, t_ini, t_eq = ajustar_tau(t_s[m_enf] - t_enf_ini, temp_c[m_enf], tau_semilla=10.0)
        c_th = c_termica(tau, r_th)

        resultados.append(
            {
                "ciclo": k + 1,
                "r_th": r_th,
                "tau": tau,
                "c_th": c_th,
                "t_eq": t_eq,
            }
        )
    return resultados


def graficar_ciclos(
    t_s: np.ndarray, temp_c: np.ndarray, power_w: np.ndarray, salida: Path
) -> None:
    """Grafica los 12 minutos marcando cada minuto de prueba de estrés."""
    fig, (ax1, ax2) = plt.subplots(2, 1, figsize=(10, 6), sharex=True)

    for minuto in range(12):
        a, b = minuto * 60.0, (minuto + 1) * 60.0
        if minuto % 2 == 1:
            ax1.axvspan(
                a,
                b,
                color="#ffe6e6",
                alpha=0.55,
                label="Prueba de estrés (1 min)" if minuto == 1 else None,
            )
            ax2.axvspan(a, b, color="#ffe6e6", alpha=0.55)

    ax1.plot(t_s, temp_c, color="#1f77b4", lw=1.4, label=COL_TEMP)
    ax1.set_ylabel("Temperatura [°C]")
    ax1.set_title("12 Minutos: 1 min Normal / 1 min Prueba de Estrés")
    ax1.legend(loc="lower right", fontsize=8)
    ax1.grid(True, alpha=0.3)

    ax2.plot(t_s, power_w, color="#ff7f0e", lw=1.2, label=COL_POTENCIA)
    ax2.set_xlabel("TiempoSimulacion [s]")
    ax2.set_ylabel("Potencia [W]")
    ax2.legend(loc="upper left", fontsize=8)
    ax2.grid(True, alpha=0.3)

    plt.tight_layout()
    plt.savefig(salida, dpi=150)
    plt.close(fig)


def main() -> None:
    ruta_csv = Path("pulsos.CSV")
    t_s, temp_c, power_w, htc_flag = cargar_columnas_pulsos(ruta_csv)

    ciclos = analizar_todos_los_ciclos(t_s, temp_c, power_w, n_ciclos=6)
    graficar_ciclos(t_s, temp_c, power_w, Path("pulsos_todos_ciclos.png"))

    print(f"Eventos HTC activos: {int(np.sum(htc_flag))}")
    for c in ciclos:
        print(
            f"Ciclo {c['ciclo']}: R_th = {c['r_th']:.4f} °C/W | "
            f"tau = {c['tau']:.2f} s | C_th = {c['c_th']:.2f} J/°C"
        )

    r_vals = np.array([c["r_th"] for c in ciclos], dtype=float)
    tau_vals = np.array([c["tau"] for c in ciclos], dtype=float)
    c_vals = np.array([c["c_th"] for c in ciclos], dtype=float)

    print(
        f"\nPromedio general -> R_th = {np.nanmean(r_vals):.4f} °C/W | "
        f"tau = {np.nanmean(tau_vals):.2f} s | C_th = {np.nanmean(c_vals):.2f} J/°C"
    )


if __name__ == "__main__":
    main()
    
    
